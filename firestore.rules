// firestore.rules — Kanarii v2
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS DE SEGURIDAD ───────────────────────────────────────────────
    
    // Devuelve true si el usuario tiene el rol exacto pedido en la comunidad
    function hasRole(communityId, role) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)) && 
             get(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)).data.rol == role;
    }

    // Devuelve true si el usuario tiene al menos ese nivel de rol local
    // Orden: visitante < miembro < admin
    function hasMinRole(communityId, minRole) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)) && (
               minRole == 'visitante' ||
               (minRole == 'miembro' && (
                 get(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)).data.rol == 'miembro' || 
                 get(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)).data.rol == 'admin'
               )) ||
               (minRole == 'admin' && get(/databases/$(database)/documents/community_members/$(communityId + '_' + request.auth.uid)).data.rol == 'admin')
             );
    }

    // Devuelve true si el usuario es el administrador global de la plataforma
    function isGlobalAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Devuelve true si el usuario es el autor del recurso que se está actualizando/borrando
    function isAuthor() {
      return request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Devuelve true si la invitación existe, está activa, no ha expirado y no ha superado sus usos máximos
    function isValidInvitation(invitationCode, communityId) {
      let path = /databases/$(database)/documents/invitaciones/$(invitationCode);
      return exists(path)
        && get(path).data.activo == true
        && get(path).data.communityId == communityId
        && (get(path).data.expiraEn == null || get(path).data.expiraEn > request.time)
        && (get(path).data.usosMaximos == null || get(path).data.usosActuales < get(path).data.usosMaximos);
    }

    // Devuelve true si el usuario es administrador de la comunidad en los datos almacenados
    // o en los datos del lote que se están guardando en este momento (getAfter)
    function isCommunityAdmin(communityId, userId) {
      let path = /databases/$(database)/documents/comunidades/$(communityId);
      return (exists(path) && get(path).data.adminUids.hasAny([userId])) ||
             (existsAfter(path) && getAfter(path).data.adminUids.hasAny([userId]));
    }

    // ─── USUARIOS GLOBALES ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'user' || 
        request.resource.data.role == 'member'
      ) || isGlobalAdmin();
      allow update: if (request.auth != null && request.auth.uid == uid && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      )) || isGlobalAdmin();
      allow delete: if (request.auth != null && request.auth.uid == uid) || isGlobalAdmin();
    }

    // ─── PERFILES DE USUARIO ───────────────────────────────────────────────
    match /profiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == uid) || isGlobalAdmin();
    }

    // ─── COMUNIDADES ───────────────────────────────────────────────────────
    match /comunidades/{communityId} {
      // Lectura autenticada por defecto
      allow read: if request.auth != null;
      // Crear comunidad: cualquier autenticado
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      // Actualizar/borrar: solo admin local de esa comunidad o global admin
      allow update, delete: if hasRole(communityId, 'admin') || isGlobalAdmin();

      // Solicitudes de membresía anidadas en comunidades
      match /solicitudes/{solicitudId} {
        allow create: if request.auth != null && request.resource.data.solicitante_uid == request.auth.uid;
        allow read, update, delete: if request.auth != null && (
          resource.data.solicitante_uid == request.auth.uid ||
          hasRole(communityId, 'admin') ||
          isGlobalAdmin()
        );
      }
    }

    // ─── MEMBRESÍAS (Colección Plana) ──────────────────────────────────────
    match /community_members/{membershipId} {
      // Leer: Propio o miembro de la comunidad
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        hasMinRole(resource.data.communityId, 'miembro')
      );
      // Crear: Si eres administrador local/creador, o te unes con invitación/sin aprobación
      allow create: if request.auth != null && (
        hasRole(request.resource.data.communityId, 'admin') ||
        isCommunityAdmin(request.resource.data.communityId, request.auth.uid) ||
        (
          request.resource.data.userId == request.auth.uid &&
          !(request.resource.data.rol in ['admin', 'propietario']) &&
          (
            (
              exists(/databases/$(database)/documents/comunidades/$(request.resource.data.communityId)) &&
              get(/databases/$(database)/documents/comunidades/$(request.resource.data.communityId)).data.requiereAprobacion == false
            ) ||
            (
              request.resource.data.codigoInvitacion != null &&
              isValidInvitation(request.resource.data.codigoInvitacion, request.resource.data.communityId)
            )
          )
        )
      );
      // Actualizar: solo admin de la comunidad o admin global
      allow update: if request.auth != null && (hasRole(resource.data.communityId, 'admin') || isGlobalAdmin());
      // Borrar: Propio usuario que sale de la comunidad o admin de la comunidad que expulsa o admin global
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin()
      );

      // Subcolección de notificaciones del miembro
      match /notificaciones/{notifId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/community_members/$(membershipId)).data.userId == request.auth.uid;
      }
    }

    // ─── INVITACIONES (Colección Plana) ────────────────────────────────────
    match /invitaciones/{codigo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (hasRole(request.resource.data.communityId, 'admin') || isGlobalAdmin());
      allow update: if request.auth != null && (
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin() ||
        (
          // Incremento controlado de usos al unirse
          request.resource.data.usosActuales == resource.data.usosActuales + 1 &&
          request.resource.data.communityId == resource.data.communityId &&
          request.resource.data.creadoPor == resource.data.creadoPor &&
          request.resource.data.tipo == resource.data.tipo &&
          request.resource.data.expiraEn == resource.data.expiraEn &&
          request.resource.data.usosMaximos == resource.data.usosMaximos &&
          (
            request.resource.data.activo == resource.data.activo ||
            (request.resource.data.activo == false && (
              resource.data.tipo == 'unico_uso' ||
              (resource.data.usosMaximos != null && request.resource.data.usosActuales >= resource.data.usosMaximos)
            ))
          )
        )
      );
      allow delete: if request.auth != null && (hasRole(resource.data.communityId, 'admin') || isGlobalAdmin());
    }

    // ─── REGISTROS DE SALIDA (Colección Plana) ──────────────────────────────
    match /community_exits/{exitId} {
      // Leer: Propio usuario o admin de la comunidad correspondiente o admin global
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin()
      );
      // Crear: El propio usuario al salir
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Actualizar/Borrar: Solo admin global
      allow update, delete: if request.auth != null && isGlobalAdmin();
    }

    // ─── PROPUESTAS (Gobernanza) ──────────────────────────────────────────
    match /propuestas/{propuestaId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'visitante');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro') && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && hasMinRole(resource.data.communityId, 'miembro') && (
        isAuthor() || hasRole(resource.data.communityId, 'admin')
      );
      allow delete: if request.auth != null && (isAuthor() || hasRole(resource.data.communityId, 'admin'));

      // Hilos y respuestas de propuestas
      match /hilos/{hiloId} {
        allow read: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/propuestas/$(propuestaId)).data.communityId, 'visitante');
        allow write: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/propuestas/$(propuestaId)).data.communityId, 'miembro');
      }
      match /respuestas/{respuestaId} {
        allow read: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/propuestas/$(propuestaId)).data.communityId, 'visitante');
        allow write: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/propuestas/$(propuestaId)).data.communityId, 'miembro');
      }
    }

    // ─── TAREAS ────────────────────────────────────────────────────────────
    match /tareas/{taskId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'miembro');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro');
      allow update: if request.auth != null && hasMinRole(resource.data.communityId, 'miembro') && (
        resource.data.createdBy == request.auth.uid || hasRole(resource.data.communityId, 'admin')
      );
      allow delete: if request.auth != null && (resource.data.createdBy == request.auth.uid || hasRole(resource.data.communityId, 'admin'));
    }

    // ─── PROYECTOS ─────────────────────────────────────────────────────────
    match /proyectos/{proyectoId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'miembro');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro');
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid || hasRole(resource.data.communityId, 'admin')
      );
    }

    // ─── EVENTOS ───────────────────────────────────────────────────────────
    match /eventos/{eventoId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'visitante');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro');
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid || hasRole(resource.data.communityId, 'admin')
      );
    }

    // ─── POSTS ─────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'visitante');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro');
      allow update, delete: if request.auth != null && (
        resource.data.autorId == request.auth.uid || hasRole(resource.data.communityId, 'admin')
      );

      match /respuestas/{respuestaId} {
        allow read: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/posts/$(postId)).data.communityId, 'visitante');
        allow write: if request.auth != null && hasMinRole(get(/databases/$(database)/documents/posts/$(postId)).data.communityId, 'miembro');
      }
    }

    // ─── SERVICIOS ─────────────────────────────────────────────────────────
    match /servicios/{serviceId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'visitante');
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro') && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.providerId == request.auth.uid || hasRole(resource.data.communityId, 'admin')
      );
    }

    // ─── ACUERDOS ──────────────────────────────────────────────────────────
    match /acuerdos/{acuerdoId} {
      allow read: if request.auth != null && (
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        hasMinRole(resource.data.communityId, 'miembro') ||
        isGlobalAdmin()
      );
      allow create: if request.auth != null && hasMinRole(request.resource.data.communityId, 'miembro');
      allow update: if request.auth != null && (
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin()
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['solicitanteLastSeenAt']) ||
        request.auth.uid == resource.data.solicitanteId
      );
      allow delete: if request.auth != null && (
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin()
      );
    }

    // ─── ACTAS ─────────────────────────────────────────────────────────────
    match /actas/{actaId} {
      allow read: if request.auth != null && hasMinRole(resource.data.communityId, 'visitante');
      allow create: if request.auth != null && (hasRole(request.resource.data.communityId, 'admin') || isGlobalAdmin());
      allow update, delete: if request.auth != null && (hasRole(resource.data.communityId, 'admin') || isGlobalAdmin());
    }

    // ─── FICHAS (Privadas: solo dueño o admin de comunidad) ─────────────────
    match /fichas/{fichaId} {
      allow read: if request.auth != null && (
        request.auth.uid == fichaId || 
        (resource.data.communityId != null && hasRole(resource.data.communityId, 'admin')) ||
        isGlobalAdmin()
      );
      allow create: if request.auth != null && (
        request.auth.uid == fichaId || 
        (request.resource.data.communityId != null && hasRole(request.resource.data.communityId, 'admin')) ||
        isGlobalAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == fichaId || 
        (resource.data.communityId != null && hasRole(resource.data.communityId, 'admin')) ||
        isGlobalAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == fichaId || 
        (resource.data.communityId != null && hasRole(resource.data.communityId, 'admin')) ||
        isGlobalAdmin()
      );
    }

    // ─── PASAPORTES (Públicos para la app, filtrados por privacidad) ─────────
    match /pasaportes/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isGlobalAdmin());
    }

    // ─── CONEXIONES DE MIEMBROS ─────────────────────────────────────────────
    match /connections/{connectionId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.receiverId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ─── SOLICITUDES GLOBALES ──────────────────────────────────────────────
    match /joinRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        hasRole(resource.data.communityId, 'admin') ||
        isGlobalAdmin()
      );
    }

    // ─── IDENTIDADES VINCULADAS DE TELEGRAM ────────────────────────────────
    match /user_telegram_identities/{userId} {
      allow read, write: if true;
    }

    // ─── LOGS DE AUDITORÍA INMUTABLES ──────────────────────────────────────
    match /audit_logs/{id} {
      allow read, create: if true;
      allow update, delete: if false; // Traza inmutable
    }

    // ─── ACCIONES PENDIENTES (CONFIRMACIONES DE 2 PASOS) ───────────────────
    match /pending_actions/{id} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isGlobalAdmin());
    }
  }
}

