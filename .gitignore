node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
scratch/
.vite_cache/
# external-inbox/ se trackea como carpeta vacía pero su contenido no se sube
external-inbox/*
!external-inbox/.gitkeep
# .agent-session.lock se trackea como plantilla pero nunca debe commitearse con status=open
# Para forzar reset manual: editar status a "template" o borrar el archivo

# Temporales y Backups
.tmp/
backup/
out.txt
.firebase/
functions/lib/
dev-dist/

# LLM Context Digests — generados bajo demanda, efímeros, no se versionan
docs/llm-context/*
!docs/llm-context/.gitkeep
!docs/llm-context/README.md
# Agent OS — generated context files

# Digests LLM — generados bajo demanda, no se versionan
docs/llm-context/*
!docs/llm-context/.gitkeep
!docs/llm-context/README.md

# Estado de sincronización — local de cada máquina
.agents/context/last-sync.md
.agents/context/agent-os-changelog.md

# Session lock — nunca commitear con status=open
# Para forzar reset: editar status a "template" o borrar el archivo
.agent-session.lock

# External inbox — se trackea la carpeta vacía, no el contenido
docs/external-inbox/*
!docs/external-inbox/.gitkeep
