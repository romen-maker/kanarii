node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
scratch/
.vite_cache/
# external-inbox/ se trackea como carpeta vacía pero su contenido no se sube
external-inbox/*
!external-inbox/.gitkeep
# .agent-session.lock se trackea como plantilla pero nunca debe commitearse con status=open
# Para forzar reset manual: editar status a "template" o borrar el archivo

# Temporales y Backups
.tmp/
backup/
out.txt
.firebase/

# LLM Context Digests — generados bajo demanda, efímeros, no se versionan
docs/llm-context/*
!docs/llm-context/.gitkeep
!docs/llm-context/README.md
