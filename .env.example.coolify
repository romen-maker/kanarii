# ==============================================================================
# 🌿 KANARII — PLANTILLA DE VARIABLES DE ENTORNO PARA COOLIFY
# ==============================================================================
# ⚠️ IMPORTANTE: Coolify distingue entre variables de COMPILACIÓN (Build-time)
# y variables de EJECUCIÓN (Runtime). Respeta esta división para evitar que la SPA
# quede empaquetada con valores obsoletos o que el backend falle al arrancar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🛠️ FASE 1: VARIABLES DE COMPILACIÓN (BUILD-TIME ARGS)
# 💡 Propósito: Vite las incrusta estáticamente en el bundle JS durante `docker build`.
# ⚠️ Si cambias estas variables en Coolify, DEBES FORZAR UN RE-DESPLIEGUE (Rebuild).
# ------------------------------------------------------------------------------
VITE_API_BASE=/api/v1
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=kanarii-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0601258149
VITE_FIREBASE_DATABASE_ID=ai-studio-fb5ef2e1-c472-43e5-bb6a-51f1141b0793
VITE_FIREBASE_STORAGE_BUCKET=kanarii-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# ------------------------------------------------------------------------------
# ⚡ FASE 2: VARIABLES DE TIEMPO DE EJECUCIÓN (RUNTIME-ONLY ENV)
# 💡 Propósito: Servidor Node.js (src/server.ts) y adaptadores backend las leen en vivo.
# ℹ️ Si cambias estas variables en Coolify, solo necesitas REINICIAR el contenedor.
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 🤖 Adaptador Telegram (Bot grammY)
ENABLE_TELEGRAM_BOT=true
TELEGRAM_BOT_TOKEN=7890123456:AAG...

# 🔐 Adaptador HTTP API (Protección de Endpoints REST /api/v1)
API_TOKEN=sk_kanarii_live_token_secret_12345
